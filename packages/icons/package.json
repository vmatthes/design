{
  "name": "@volkermatthes/icons",
  "version": "0.0.1",
  "description": "SVG icons as React and React Native components",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/native"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./native": {
      "types": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsup",
    "typecheck": "pnpm generate && tsc --noEmit",
    "clean": "rimraf dist src/generated",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@svgr/cli": "^6.1.2",
    "@types/react": "^19.2.10",
    "rimraf": "^5.0.5",
    "tsup": "^7.0.0",
    "typescript": "^5.4.5"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  }
}
