{
  "name": "@volkermatthes/design",
  "version": "0.2.0",
  "description": "Design tokens of letmeshowyou and Rudel: TypeScript, CSS variables and Swift (DesignKit)",
  "repository": {
    "type": "git",
    "url": "https://github.com/vmatthes/design.git",
    "directory": "packages/design"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "tokens.css",
    "base.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "5.9.3",
    "tsup": "^8.5.0"
  }
}
